import pandas as pd
import math
from collections import Counter

def _tokenize(line: str):
    toks = [t.strip() for t in line.split("|")]
    if toks and toks[0] == "":
        toks = toks[1:]
    if toks and toks[-1] == "":
        toks = toks[:-1]
    return toks

def _value_count(tokens):
    return sum(1 for t in tokens if t)

def _dedup_columns(cols):
    seen = Counter()
    out = []
    for c in cols:
        name = c if c else "col"
        seen[name] += 1
        out.append(name if seen[name] == 1 else f"{name}_{seen[name]}")
    return out

def extract_markdown_tables(md: str, header_frac: float = 0.6):
    """
    Extract multiple pipe-delimited tables from messy markdown.
    Returns concatenated dataframe and list of tables.
    """
    lines = md.split("\n")
    parsed = []
    for ln in lines:
        toks = _tokenize(ln) if "|" in ln else []
        parsed.append({
            "line": ln,
            "tokens": toks,
            "val_count": _value_count(toks),
            "field_count": len(toks)
        })

    max_vals = max((p["val_count"] for p in parsed if p["tokens"]), default=0)
    if max_vals == 0:
        return pd.DataFrame(), []

    cutoff = math.ceil(header_frac * max_vals)

    tables, curr_header, curr_rows = [], [], []
    in_table = False

    def flush():
        nonlocal curr_header, curr_rows, in_table
        if curr_header:
            df = pd.DataFrame(curr_rows, columns=curr_header)
            tables.append(df)
        curr_header, curr_rows, in_table = [], [], False

    for p in parsed:
        toks = p["tokens"]

        if not toks:  # blank/non-pipe line
            if in_table:
                flush()
            continue

        # potential header
        if not in_table and p["val_count"] >= cutoff:
            curr_header = _dedup_columns(toks)
            in_table = True
            continue

        if in_table:
            # align row to header width
            if len(toks) < len(curr_header):
                toks = toks + [""] * (len(curr_header) - len(toks))
            elif len(toks) > len(curr_header):
                toks = toks[:len(curr_header)]
            curr_rows.append(toks)

    if in_table:
        flush()

    concatenated = pd.concat(tables, ignore_index=True) if tables else pd.DataFrame()
    return concatenated, tables