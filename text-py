import pandas as pd

def extract_markdown_tables(md_string: str, threshold: float = 0.6):
    """
    Extract tables from a markdown string into pandas DataFrames.
    
    Args:
        md_string (str): Markdown text with '|' separated rows.
        threshold (float): Fraction of max columns required to consider a row as table header.
        
    Returns:
        pd.DataFrame: Concatenated dataframe of all extracted tables.
        list[pd.DataFrame]: List of individual table dataframes.
    """
    lines = [line.strip() for line in md_string.split("\n") if line.strip()]
    split_lines = [line.split("|") for line in lines if "|" in line]

    # Normalize: strip whitespace from each cell
    split_lines = [[cell.strip() for cell in row if cell.strip() != ""] for row in split_lines]

    if not split_lines:
        return pd.DataFrame(), []

    # Determine max column count
    max_cols = max(len(row) for row in split_lines)

    tables = []
    current_table = []
    header_found = False

    for row in split_lines:
        if len(row) >= threshold * max_cols:
            # Likely a header row
            if current_table:
                # save previous table if exists
                try:
                    df = pd.DataFrame(current_table[1:], columns=current_table[0])
                except Exception:
                    df = pd.DataFrame(current_table)
                tables.append(df)
                current_table = []
            current_table.append(row)
            header_found = True
        else:
            # part of table if a header was found
            if header_found:
                current_table.append(row)
            else:
                # skip junk rows before any header
                continue

    # save last table
    if current_table:
        try:
            df = pd.DataFrame(current_table[1:], columns=current_table[0])
        except Exception:
            df = pd.DataFrame(current_table)
        tables.append(df)

    # Concatenate
    concatenated = pd.concat(tables, ignore_index=True) if tables else pd.DataFrame()
    return concatenated, tables

md = """
Some intro text

| Name | Age | City |
| John | 25 | New York |
| Alice | 30 | London |

Some random footer

| Product | Price |
| Apple   | 100  |
| Banana  | 50   |
"""

df_all, dfs = extract_markdown_tables(md)

print("Concatenated DataFrame:")
print(df_all)




