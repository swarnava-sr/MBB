import pandas as pd

def extract_tables_from_markdown(md_string: str) -> pd.DataFrame:
    """
    Extract tables from markdown-like string (using | separated rows and \n newlines).
    Returns a concatenated pandas DataFrame from all detected tables.
    """

    # Split into lines
    lines = [line.strip() for line in md_string.split("\n") if line.strip()]

    # Split rows into list of values
    split_lines = [line.strip("|").split("|") for line in lines]

    # Clean extra spaces
    split_lines = [[col.strip() for col in row] for row in split_lines]

    # Find maximum column count
    max_cols = max((len(row) for row in split_lines), default=0)

    if max_cols == 0:
        return pd.DataFrame()  # no tables found

    # Threshold to decide if a row is a table header
    min_header_cols = int(0.6 * max_cols)

    tables = []
    current_table = []
    header = None

    for row in split_lines:
        if len(row) >= min_header_cols:  
            # Potential header row → start of a new table
            if current_table and header:
                # Convert old table to DataFrame
                df = pd.DataFrame(current_table, columns=header)
                tables.append(df)
                current_table = []

            header = row  # set new header
        else:
            # Data row
            if header:  # Only add if we already have a header
                # Fill missing cols if uneven
                while len(row) < len(header):
                    row.append("")
                current_table.append(row)

    # Catch last table
    if current_table and header:
        df = pd.DataFrame(current_table, columns=header)
        tables.append(df)

    # Combine all tables (align columns automatically, NaNs for missing cols)
    if tables:
        return pd.concat(tables, ignore_index=True, sort=False)
    else:
        return pd.DataFrame()
