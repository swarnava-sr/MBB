import math
import pandas as pd
from collections import Counter

def _tokenize(line: str):
    toks = [t.strip() for t in line.strip().split("|")]
    if toks and toks[0] == "":  # drop border pipes
        toks = toks[1:]
    if toks and toks[-1] == "":
        toks = toks[:-1]
    return toks

def _value_count(tokens):
    return sum(1 for t in tokens if t != "")

def _dedup_columns(cols):
    seen = Counter()
    out = []
    for c in cols:
        name = c if c else "col"
        seen[name] += 1
        out.append(name if seen[name] == 1 else f"{name}_{seen[name]}")
    return out

def extract_markdown_tables(md: str, header_frac: float = 0.6, pad_missing=True):
    """
    Extract one or more pipe-delimited tables from messy markdown text.
    Uses heuristic: a header row has non-empty count >= header_frac * global_max_nonempty.
    
    Returns:
        concatenated_df (pd.DataFrame), tables (list[pd.DataFrame])
    """
    lines = md.split("\n")
    rows = []
    for ln in lines:
        if "|" not in ln:
            rows.append({"line": ln, "tokens": [], "val_count": 0})
            continue
        toks = _tokenize(ln)
        rows.append({
            "line": ln,
            "tokens": toks,
            "val_count": _value_count(toks)
        })

    max_vals = max((r["val_count"] for r in rows if r["tokens"]), default=0)
    if max_vals == 0:
        return pd.DataFrame(), []

    cutoff = math.ceil(header_frac * max_vals)

    tables, curr_cols, curr_rows = [], [], []
    in_table = False

    def flush():
        nonlocal curr_cols, curr_rows, in_table
        if curr_cols and curr_rows:
            df = pd.DataFrame(curr_rows, columns=curr_cols)
            tables.append(df)
        curr_cols, curr_rows, in_table = [], [], False

    for r in rows:
        toks = r["tokens"]
        if not toks:
            if in_table:
                flush()
            continue

        # detect header row
        if not in_table and r["val_count"] >= cutoff:
            curr_cols = _dedup_columns(toks)
            in_table = True
            continue

        if in_table:
            # data row
            if len(toks) < len(curr_cols):
                if pad_missing:
                    toks = toks + [""] * (len(curr_cols) - len(toks))
            elif len(toks) > len(curr_cols):
                # truncate extras instead of creating fake col_x
                toks = toks[:len(curr_cols)]
            curr_rows.append(toks)

    if in_table:
        flush()

    concatenated = pd.concat(tables, ignore_index=True) if tables else pd.DataFrame()
    return concatenated, tables