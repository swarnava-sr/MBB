import pandas as pd
from collections import Counter

def parse_markdown_tables(md_text, add_table_id=True):
    # Step 1: Tokenize each line
    rows = []
    for line in md_text.strip().split("\n"):
        cells = [c.strip() for c in line.split("|") if c.strip()]
        if cells:
            rows.append(cells)
        else:
            rows.append([])  # mark blank row

    # Step 2: Split into contiguous non-blank blocks
    tables, block = [], []
    for row in rows:
        if row:
            block.append(row)
        else:
            if block:
                tables.append(block)
                block = []
    if block:
        tables.append(block)

    dfs = []
    for t_idx, block in enumerate(tables):
        # Step 3: Identify header row by max non-numeric cells
        header_idx, max_non_numeric = -1, -1
        for i, row in enumerate(block):
            non_numeric_count = sum(1 for c in row if not c.replace(".", "").isdigit())
            if non_numeric_count > max_non_numeric:
                max_non_numeric = non_numeric_count
                header_idx = i

        if header_idx == -1:
            continue

        headers = block[header_idx]
        data = []
        for row in block[header_idx+1:]:
            if len(row) != len(headers) or not row:
                break
            data.append(row)

        if data:
            df = pd.DataFrame(data, columns=headers)
            if add_table_id:
                df.insert(0, "TableID", t_idx+1)
            dfs.append(df)

    # Step 4: Merge all tables into one consolidated DataFrame
    if not dfs:
        return pd.DataFrame()
    consolidated = pd.concat(dfs, ignore_index=True, sort=False).fillna("")
    return consolidated

# -----------------------
# Example: single table
single_md = """| Item | Quantity | Price |
| Pen  | 10       | 5     |
| Book |          | 20    |
| Pencil | 5      | 3     |"""

df_single = parse_markdown_tables(single_md)
print("Single table result:\n", df_single, "\n")

# Example: multiple tables
multi_md = """
| Item | Quantity | Price |
| Pen  | 10       | 5     |
| Book | 2        | 20    |

| Description | Amount |
| Shipping    | 100    |
| Tax         | 18     |
"""

df_multi = parse_markdown_tables(multi_md)
print("Multiple tables result:\n", df_multi)