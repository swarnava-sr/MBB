import pandas as pd

def parse_markdown_tables(md_text, add_table_id=True):
    # Step 1: Tokenize each line
    rows = []
    for line in md_text.strip().split("\n"):
        cells = [c.strip() for c in line.split("|")]
        # drop outer empties caused by leading/trailing |
        if cells and cells[0] == "":
            cells = cells[1:]
        if cells and cells[-1] == "":
            cells = cells[:-1]
        # keep only if row is not empty
        if any(cells):
            rows.append(cells)
        else:
            rows.append([])  # mark blank row

    # Step 2: Split into contiguous non-blank blocks
    tables, block = [], []
    for row in rows:
        if row:
            block.append(row)
        else:
            if block:
                tables.append(block)
                block = []
    if block:
        tables.append(block)

    dfs = []
    for t_idx, block in enumerate(tables):
        # --- Detect header row ---
        header_idx, max_score = -1, -1
        for i, row in enumerate(block):
            if len(row) < 2:  # not a table header (at least 2 cols required)
                continue
            # score = proportion of non-numeric cells
            non_numeric = sum(1 for c in row if not c.replace(".", "").isdigit())
            score = non_numeric / len(row)
            if score > max_score:
                max_score = score
                header_idx = i

        if header_idx == -1:
            continue

        headers = block[header_idx]
        data = []
        for row in block[header_idx+1:]:
            # stop when blank or misaligned row
            if not row or len(row) != len(headers):
                break
            data.append(row)

        if not data:
            continue

        df = pd.DataFrame(data, columns=headers)
        if add_table_id:
            df.insert(0, "TableID", t_idx+1)
        dfs.append(df)

    # Step 3: Consolidate
    if not dfs:
        return pd.DataFrame()
    consolidated = pd.concat(dfs, ignore_index=True, sort=False).fillna("")
    return consolidated


# -----------------------
# Example: single table
single_md = """| Item | Quantity | Price |
| Pen  | 10       | 5     |
| Book |          | 20    |
| Pencil | 5      | 3     |"""

df_single = parse_markdown_tables(single_md)
print("Single table result:\n", df_single, "\n")

# Example: multiple tables
multi_md = """
| Item | Quantity | Price |
| Pen  | 10       | 5     |
| Book | 2        | 20    |

| Description | Amount |
| Shipping    | 100    |
| Tax         | 18     |
"""

df_multi = parse_markdown_tables(multi_md)
print("Multiple tables result:\n", df_multi)